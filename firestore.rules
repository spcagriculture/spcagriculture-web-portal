rules_version = '2';

/**
 * Firestore rules for SPC Agriculture web portal.
 *
 * Department-scoped CMS data lives under departments/{deptId}/{collection}/{docId}.
 * Legacy top-level collections remain readable during migration.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Department-scoped content
    match /departments/{deptId}/{collection}/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Legacy collections (read-only after migration; writes for transition period)
    match /services/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /news/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /notices/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /publications/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /videos/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /galleryEvents/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /projects/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /circulars/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /documents/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /officers/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /exams/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /vacancies/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /exam_results/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /department_statistics/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /portalSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
