rules_version = '2';

/**
 * Firestore rules for SPC Agriculture web portal.
 *
 * - Public site: read-only for all CMS collections.
 * - Admin (any signed-in user): create / update / delete.
 *
 * To restrict writes to specific admin emails or custom claims, replace
 * `isSignedIn()` with something like:
 *   request.auth != null && request.auth.token.admin == true
 * and set claims in Firebase Admin SDK or Cloud Functions.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Public content (read by anonymous visitors; CRUD from admin when signed in) ---

    match /services/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /news/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /notices/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /publications/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /videos/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /galleryEvents/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /projects/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /circulars/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /documents/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /officers/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /exams/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /vacancies/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /exam_results/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /department_statistics/{docId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
