rules_version = '2';

/**
 * Firebase Storage rules — department-scoped uploads under departments/{deptId}/...
 * Legacy paths remain during migration.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Department-scoped uploads
    match /departments/{deptId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Legacy paths (migration period)
    match /news/images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /notices/images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /publications/covers/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /publications/files/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /projects/images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /gallery/images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /officers/images/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /circulars/pdfs/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /documents/pdfs/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /exams/pdfs/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /vacancies/pdfs/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /results/pdfs/{fileName} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
